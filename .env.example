# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Anthropic API key (optional if authenticated via OAuth with `claude` CLI)
# ANTHROPIC_API_KEY=your_api_key_here

# Path to your Obsidian vault (Claude's working directory)
OBSIDIAN_VAULT_PATH=/path/to/your/vault

# Optional: Comma-separated list of Telegram user IDs allowed to use the bot
# Leave empty to allow all users (not recommended for production)
ALLOWED_USER_IDS=123456789

# Log level: debug, info, warn, error, none (default: info)
# - debug: Verbose logging including all events and data
# - info: Standard operational logging
# - warn: Warnings and errors only
# - error: Errors only
# - none: No logging
LOG_LEVEL=info
